<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1 http://maven.apache.org/xsd/assembly-2.1.1.xsd">
    <id>release-with-jre</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>${project.artifactId}-${project.version}</baseDirectory>

    <fileSets>
        <!-- Include the bundled JRE -->
        <fileSet>
            <directory>${project.build.directory}/release/jre</directory>
            <outputDirectory>jre</outputDirectory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>

        <!-- Include libraries -->
        <fileSet>
            <directory>${project.build.directory}/release/lib</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>*.jar</include>
            </includes>
        </fileSet>

        <!-- Include standalone JAR -->
        <fileSet>
            <directory>${project.build.directory}/release</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>${project.artifactId}-${project.version}-jar-with-dependencies.jar</include>
            </includes>
        </fileSet>

        <!-- Include documentation -->
        <fileSet>
            <directory>${project.build.directory}/release</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>README.md</include>
                <include>QUICKREF.md</include>
                <include>EXAMPLES.md</include>
            </includes>
        </fileSet>

        <!-- Include scripts -->
        <fileSet>
            <directory>${project.build.directory}/release</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>run.bat</include>
                <include>run.sh</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- Include JRE-aware scripts -->
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>run-with-jre.bat</include>
                <include>run-with-jre.sh</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
    </fileSets>
</assembly>
